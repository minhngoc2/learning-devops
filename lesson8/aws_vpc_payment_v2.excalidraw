  {
   "type": "text",
   "id": "rt_why",
   "x": 0,
   "y": 2280,
   "width": 1260.0,
   "height": 18.75,
   "strokeColor": "#3b82f6",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1364,
   "version": 1,
   "versionNonce": 1365,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "updated": 1,
   "frameId": null,
   "roundness": null,
   "text": "Why one app route table per AZ? If AZ-1a fails, apps in 1c still egress through nat-1c — no cross-AZ dependency and no cross-AZ data charge.",
   "originalText": "Why one app route table per AZ? If AZ-1a fails, apps in 1c still egress through nat-1c — no cross-AZ dependency and no cross-AZ data charge.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
