variable "name" {
  description = "Identifier for the DB instance, subnet group and security group (<name>-db)."
  type        = string

  validation {
    condition     = length(var.name) <= 63 && can(regex("^[a-z]([a-z0-9]|-[a-z0-9])*$", var.name))
    error_message = "name must be 1–63 lowercase letters, digits or single hyphens, start with a letter and not end with a hyphen (RDS identifier rule)."
  }
}

variable "vpc_id" {
  description = "VPC for the DB security group."
  type        = string
}

variable "subnet_ids" {
  description = "Private subnets (in at least two AZs) for the DB subnet group."
  type        = list(string)

  validation {
    condition     = length(distinct(var.subnet_ids)) >= 2
    error_message = "Provide at least two distinct private subnet IDs in different AZs."
  }
  nullable = false
}

variable "engine_version" {
  description = "PostgreSQL major version only; AWS applies minor upgrades automatically (auto_minor_version_upgrade)."
  type        = string
  default     = "17"

  validation {
    # A pinned minor (e.g. "17.2") would make every plan try to downgrade after AWS upgrades the instance.
    condition     = can(regex("^[0-9]+$", var.engine_version))
    error_message = "engine_version must be a major version such as \"17\", not a minor like \"17.2\"."
  }
}

variable "instance_class" {
  description = "DB instance class."
  type        = string
  default     = "db.t4g.micro"
}

variable "db_name" {
  description = "Initial database name: starts with a letter; letters, digits, underscores; at most 63."
  type        = string
  default     = "app"

  validation {
    condition     = can(regex("^[A-Za-z][A-Za-z0-9_]{0,62}$", var.db_name))
    error_message = "db_name must start with a letter and contain only letters, digits or underscores (max 63)."
  }
}

variable "username" {
  description = "Master username (the password is generated by RDS): starts with a letter; letters, digits, underscores; at most 63."
  type        = string
  default     = "app"

  validation {
    condition     = can(regex("^[A-Za-z][A-Za-z0-9_]{0,62}$", var.username))
    error_message = "username must start with a letter and contain only letters, digits or underscores (max 63)."
  }
}

variable "multi_az" {
  description = "Run a standby in a second AZ."
  type        = bool
  default     = false
}

variable "backup_retention_period" {
  description = "Days of automated backups (0 disables them)."
  type        = number
  default     = 1

  validation {
    condition     = var.backup_retention_period >= 0 && var.backup_retention_period <= 35
    error_message = "backup_retention_period must be between 0 and 35."
  }
}

variable "deletion_protection" {
  description = "Block deletion of the instance. Turn on for anything that is not a lab."
  type        = bool
  default     = true
}

variable "skip_final_snapshot" {
  description = "Skip the snapshot when the instance is destroyed."
  type        = bool
  default     = false
}

variable "final_snapshot_identifier" {
  description = "Optional final snapshot name; choose a new name when a previous final snapshot already exists."
  type        = string
  default     = null

  validation {
    condition     = var.final_snapshot_identifier == null || (length(coalesce(var.final_snapshot_identifier, "x")) <= 255 && can(regex("^[A-Za-z]([A-Za-z0-9]|-[A-Za-z0-9])*$", coalesce(var.final_snapshot_identifier, "x"))))
    error_message = "final_snapshot_identifier must start with a letter, use letters, digits or single hyphens, not end with a hyphen, and be at most 255 characters."
  }
}
